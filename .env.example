# Copy to .env (git-ignored) and fill in what you use. Variables already set in your
# shell win over this file. Keys set in Settings (config.json) win over both.

# Google Gemini (or set apiKey in Settings)
GEMINI_API_KEY=

# Fallback provider asked when every Gemini model is busy or out of quota.
# NVIDIA NIM: the key alone sets the base URL to https://integrate.api.nvidia.com/v1;
# pick the model in Settings -> Fallback provider (e.g. minimaxai/minimax-m3.1-flash).
NVIDIA_API_KEY=
# Any other OpenAI-compatible provider (OpenRouter...): used before NVIDIA_API_KEY.
# Set its base URL and model in Settings.
# OPENAI_COMPAT_API_KEY=